# Server-side Vite development proxy; not exposed as a VITE_ client variable.
API_PROXY_TARGET=http://localhost:3000

# Production: serve static build from dist/client and route /api/* to the backend
# on the same public origin (reverse proxy). Do not expose API_PROXY_TARGET to the browser.
# See backend/PRODUCTION.md and cp-frontend/AUTH_CONVENTIONS.md.
