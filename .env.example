# Backend origin for Start middleware `/api` proxy (dev, preview, `pnpm start`).
# SSR session probe also uses this (direct GET /auth/session). Not a VITE_* variable.
# Set at runtime for Node (systemd, k8s) — not only at build time.
API_PROXY_TARGET=http://localhost:3000

# Listen port for `node dist/server/node.js` (optional).
# The `pnpm start` script defaults to 3001.
# PORT=3001

# Verify/smoke scripts (`verify:ssr-2`, `verify:deploy`, etc.).
# BASE_URL=http://127.0.0.1:3001

# Playwright e2e (e2e/playwright.config.ts).
# PHASE_47_BASE_URL=http://localhost:3001

# Public browser origin for canonical / Open Graph when it differs from the request host (optional).
# PUBLIC_SITE_URL=https://app.example.com
# VITE_PUBLIC_SITE_URL=https://app.example.com

# Optional Google sign-in UI (build-time). Must match solve-tracker-backend GOOGLE_OAUTH_ENABLED for local dev.
# VITE_GOOGLE_OAUTH_ENABLED=false

# Production edge: same-origin `/api` → Nest; see docs/DEPLOY.md and solve-tracker-backend/PRODUCTION.md.

# Optional production hardening (Node SSR — see docs/DEPLOY.md § Security):
# ENABLE_NODE_CSP=1          # assign event.nonce + Content-Security-Policy on HTML (use 0 or unset in dev)
# TRUST_PROXY_HEADERS=1    # forward X-Forwarded-* to Nest (only when TLS terminates at a trusted edge)