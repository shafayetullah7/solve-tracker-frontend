{
  "name": "solve-tracker-frontend",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:reset": "rm -rf node_modules/.vite && vite",
    "build": "vite build",
    "start": "PORT=3001 node dist/server/node.js",
    "start:prod": "pnpm build && pnpm start",
    "serve": "vite preview",
    "test": "vitest",
    "lint": "oxlint src config",
    "typecheck": "tsc --noEmit -p .",
    "check": "pnpm typecheck && pnpm lint && vitest run",
    "api:generate": "pnpm --dir ../solve-tracker-backend api:types",
    "api:check": "pnpm --dir ../solve-tracker-backend api:types:check",
    "verify:phase-4.1": "node scripts/verify-phase-4.1.mjs",
    "verify:phase-4.7": "node scripts/verify-phase-4.7.mjs",
    "verify:ssr-1": "node scripts/verify-ssr-1.mjs",
    "verify:ssr-2": "node scripts/verify-ssr-2.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:catalog": "node scripts/verify-platform-api.mjs",
    "verify:platform-api": "node scripts/verify-platform-api.mjs",
    "verify:platform-api:full": "pnpm --dir ../solve-tracker-backend api:check && pnpm api:check && pnpm verify:platform-api",
    "verify:repo-paths": "node scripts/verify-repo-paths.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.51.0",
    "@solidjs/diagnostics": "^2.0.0-rc.21",
    "@solidjs/testing-library": "^1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.0-next.57",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^24.19.2",
    "eslint-plugin-solid": "~0.19.0",
    "filesystem-routing": "0.5.0",
    "jsdom": "^31.0.0",
    "oxlint": "~1.79.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@solidjs/meta": "^1.0.0-next.2",
    "@solidjs/router": "^2.0.0-next.44",
    "@solidjs/web": "^2.0.0-rc.21",
    "simple-icons": "11.6.0",
    "solid-js": "^2.0.0-rc.21"
  },
  "packageManager": "pnpm@12.18.0"
}
